# Copiar a .env y completar. NUNCA subir .env al repositorio.
PGHOST=localhost
PGPORT=5432
PGDATABASE=gym
PGUSER=postgres
PGPASSWORD=cambiar

PORT=4100
NODE_ENV=development

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES=12h

CORS_ORIGIN=*

# Datos que salen impresos en el comprobante de pago.
# Los que dejes vacios no se imprimen.
GYM_NOMBRE=Atletha Training
GYM_DIRECCION=Minga Guazú, Km 16 Acaray
GYM_TELEFONO=+595 993 500718

# Fotos y GIF de los ejercicios. Por defecto gym/media/.
# Solo tocalo si los guardás en otro disco.
MEDIA_DIR=./media
